- founderKingdomId.
- createdAt.
- status.

"allianceMembers"

- allianceId.
- kingdomId.
- joinedAt.
- role.
- status.

"allianceInvitations"

- allianceId.
- targetKingdomId.
- invitedByKingdomId.
- status.
- createdAt.
